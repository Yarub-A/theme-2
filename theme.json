{
  "version": 2,
  "settings": {
    "appearanceTools": true,
    "layout": {
      "contentSize": "720px",
      "wideSize": "1140px"
    },
    "spacing": {
      "units": [ "px", "rem", "em", "%", "vh", "vw" ],
      "blockGap": "1.5rem",
      "spacingScale": {
        "steps": 6,
        "mediumStep": 1.5
      }
    },
    "color": {
      "palette": [
        { "slug": "primary", "name": "Dark Blue", "color": "#0C2851" },
        { "slug": "secondary", "name": "Gold", "color": "#C5A253" },
        { "slug": "neutral-100", "name": "Neutral 100", "color": "#f8f9fa" },
        { "slug": "neutral-900", "name": "Neutral 900", "color": "#212529" }
      ]
    },
    "typography": {
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Tajawal",
          "fontFamily": "'Tajawal', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
        },
        {
          "slug": "heading",
          "name": "Noto Kufi Arabic",
          "fontFamily": "'Noto Kufi Arabic', 'Tajawal', system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "regular", "size": "1rem", "name": "Regular" },
        { "slug": "medium", "size": "1.125rem", "name": "Medium" },
        { "slug": "large", "size": "1.5rem", "name": "Large" },
        { "slug": "x-large", "size": "2rem", "name": "X-Large" }
      ],
      "lineHeight": {
        "min": 1.2,
        "max": 2.0
      }
    }
  },
  "styles": {
    "color": {
      "text": "#212529",
      "background": "#ffffff"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--regular)",
      "lineHeight": 1.7
    },
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "#ffffff"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600"
        }
      }
    },
    "blocks": {
      "core/heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "600",
          "lineHeight": 1.4
        }
      },
      "core/paragraph": {
        "typography": {
          "lineHeight": 1.8
        }
      }
    }
  }
}
